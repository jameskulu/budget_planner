# Supabase — copy to .env and fill in from your project (Dashboard > Settings > API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat — public SDK API key from app.revenuecat.com (Project > API keys).
# Requires a dev build for real purchases.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Google Play review account — gets premium access without a purchase so
# reviewers can test the full app. Use the test account you create in Supabase.
EXPO_PUBLIC_REVIEWER_EMAIL=

# Firebase / Google Analytics for Firebase — the native SDK auto-initializes
# from google-services.json (Android) and GoogleService-Info.plist (iOS).
# Requires a dev build. Web only: optional GA4 measurement id for gtag events.
EXPO_PUBLIC_GA4_MEASUREMENT_ID=
